:name: Blue Pill Modbus
:description: Sanal STM32F103 uzerinde FreeRTOS + Modbus RTU slave

using sysbus
mach create "bluepill"
machine LoadPlatformDescription @/Users/ardagoral/industrial-iot-monitoring/firmware/bluepill_rtos/bluepill.repl

# USART1: log satirlarini Renode konsoluna yaz
showAnalyzer sysbus.usart1 Antmicro.Renode.Analyzers.LoggingUartAnalyzer

# USART2: Modbus hatti. Mac'te TCP 3456 portundan erisilebilir.
emulation CreateServerSocketTerminal 3456 "modbus" false
connector Connect sysbus.usart2 modbus

# USART3: sensor hatti. Python sensor simulatoru TCP 3457 portundan veri gonderir.
emulation CreateServerSocketTerminal 3457 "sensor" false
connector Connect sysbus.usart3 sensor

$bin?=@/Users/ardagoral/industrial-iot-monitoring/firmware/bluepill_rtos/.pio/build/bluepill_f103c8/firmware.elf
sysbus LoadELF $bin

start
